{
  "name": "xyro-cli",
  "version": "0.9.1",
  "description": "XYRO — a terminal-native AI coding agent built from scratch",
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "terminal",
    "llm",
    "tui"
  ],
  "type": "module",
  "bin": {
    "xyro": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XYBERCLAN/Xyro-Cli.git"
  },
  "homepage": "https://github.com/XYBERCLAN/Xyro-Cli#readme",
  "bugs": {
    "url": "https://github.com/XYBERCLAN/Xyro-Cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --import ./src/__tests__/_isolate.ts --test src/__tests__/*.test.ts",
    "test:watch": "node --import tsx --import ./src/__tests__/_isolate.ts --test --watch src/__tests__/*.test.ts",
    "test:coverage": "node --import tsx --import ./src/__tests__/_isolate.ts --test --experimental-test-coverage --test-coverage-exclude=\"src/__tests__/**\" src/__tests__/*.test.ts",
    "test:coverage:ci": "node --import tsx --import ./src/__tests__/_isolate.ts --test --experimental-test-coverage --test-coverage-exclude=\"src/__tests__/**\" --test-coverage-lines=75 --test-coverage-functions=55 --test-coverage-branches=50 src/__tests__/*.test.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "release": "gh workflow run release.yml -f bump=patch",
    "release:minor": "gh workflow run release.yml -f bump=minor",
    "release:major": "gh workflow run release.yml -f bump=major"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@clack/prompts": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chalk": "^6.0.0",
    "commander": "^12.0.0",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "gradient-string": "^3.0.0",
    "ink": "^7.1.1",
    "openai": "^4.80.0",
    "picocolors": "^1.1.0",
    "react": "^19.2.8",
    "simple-git": "^4.0.2",
    "ts-morph": "^28.0.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
